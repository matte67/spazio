{
  "name": "spazio-tv-launcher",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:assets": "npm run build && node scripts/sync-android-assets.mjs",
    "android:build": "npm run android:assets && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:assets && cd android && ./gradlew assembleRelease && cd .. && node scripts/package-android-release.mjs",
    "format": "prettier --write src e2e scripts docs README.md android/README.md *.ts *.js *.json index.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true
}
